# FarmLink Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/farm_procurement?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_high_entropy_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Initial Admin Provisioning (Used strictly by scripts/initAdmin.js)
ADMIN_EMAIL=admin@farmlink.local
ADMIN_PASSWORD=SetAStrongPasswordMin8Chars!
ADMIN_NAME=FarmLink Administrator
ADMIN_PHONE=+919876543210
OVERWRITE_EXISTING_ADMIN=false
